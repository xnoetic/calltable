# calltable Cloud Run executor image (generated by `ct cloudrun image`).
#
# One image per calltable project: the project's toolchain comes from
# BASE_IMAGE (profile `cloudrun.base_image`) plus the profile's
# `cloudrun.install` steps; calltable adds git, Python 3.12+, the executor and
# a userspace Tailscale client so the container can reach a hub on a tailnet.
ARG BASE_IMAGE=python:3.12-slim
FROM docker.io/tailscale/tailscale:stable AS tailscale

FROM ${BASE_IMAGE}
USER root
RUN set -eu; \
    if ! command -v git >/dev/null 2>&1 || ! command -v python3 >/dev/null 2>&1; then \
      if command -v apt-get >/dev/null 2>&1; then \
        apt-get update && \
        DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
          git python3 ca-certificates && rm -rf /var/lib/apt/lists/*; \
      elif command -v apk >/dev/null 2>&1; then \
        apk add --no-cache git python3 ca-certificates; \
      elif command -v dnf >/dev/null 2>&1; then \
        dnf install -y git python3 ca-certificates && dnf clean all; \
      else \
        echo "calltable: base image needs git and python3 >= 3.12" >&2; exit 1; \
      fi; \
    fi; \
    python3 -c 'import sys; assert sys.version_info >= (3, 12), "calltable needs Python >= 3.12, base image has " + sys.version'
COPY --from=tailscale /usr/local/bin/tailscaled /usr/local/bin/tailscale /usr/local/bin/
# Test fixtures and many build scripts commit to throwaway repositories.
RUN git config --system user.name "calltable cloudrun" && \
    git config --system user.email "cloudrun@calltable.invalid" && \
    git config --system init.defaultBranch main && \
    git config --system advice.detachedHead false
# @@INSTALL@@
COPY calltable /opt/calltable/calltable
COPY entrypoint.sh /usr/local/bin/calltable-cloudrun-entrypoint
RUN chmod 0755 /usr/local/bin/calltable-cloudrun-entrypoint
ENV PYTHONPATH=/opt/calltable \
    PYTHONUNBUFFERED=1
# @@ENV@@
ENTRYPOINT ["/usr/local/bin/calltable-cloudrun-entrypoint"]
