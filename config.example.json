{
  "token": "CHANGE-ME",
  "data_dir": "./data",
  "profiles_dir": "./profiles",
  "hub_url": "http://hub.example.internal:8091",
  "hub_bind": "127.0.0.1",
  "hub_port": 8091,
  "beszel_url": "",
  "default_slot": "light",
  "hosts": {
    "runner-a": {
      "slots": {
        "heavy": 2,
        "light": 1
      },
      "labels": [
        "linux"
      ],
      "note": "Linux build runner"
    },
    "runner-b": {
      "slots": {
        "heavy": 1,
        "light": 2
      },
      "labels": [
        "windows"
      ],
      "note": "Windows runner (interactive desktop session for UI tests)"
    },
    "cloudrun": {
      "slots": {
        "heavy": 2,
        "light": 4
      },
      "labels": [
        "linux",
        "cloudrun"
      ],
      "note": "On-demand Cloud Run executions (one container per job)",
      "provider": "cloudrun",
      "cloudrun": {
        "project": "my-gcp-project",
        "region": "us-central1",
        "service_account": "calltable-exec@my-gcp-project.iam.gserviceaccount.com",
        "hub_url": "http://100.64.0.10:8091",
        "monthly_budget_usd": 120,
        "on_budget_exceeded": "queue",
        "max_task_timeout": "3h",
        "resources": {
          "light": {
            "cpu": 2,
            "memory": "8Gi"
          },
          "heavy": {
            "cpu": 8,
            "memory": "32Gi",
            "disk": "10Gi"
          }
        }
      }
    }
  },
  "exec_host": "runner-a",
  "runs_root": "./data/runs",
  "mirror_root": "./data/mirrors",
  "max_jobs": 2,
  "poll_interval": 3,
  "sample_interval": 10,
  "retention_success_seconds": 86400,
  "retention_failure_seconds": 259200,
  "log_cap_bytes": 268435456,
  "keep_ref_days": 14,
  "use_systemd": true,
  "shell": "/bin/bash",
  "owner_tailnet": "",
  "groups": {
    "linux": [
      "runner-a"
    ],
    "windows": [
      "runner-b"
    ]
  },
  "resource_defaults": {
    "heavy": {
      "memory_max": "12G",
      "cpu_weight": "400",
      "slice": "calltable-heavy.slice"
    },
    "light": {
      "memory_max": "4G",
      "cpu_weight": "200",
      "slice": "calltable-light.slice"
    }
  },
  "cpu_rate_percent": 70,
  "upstreams": {},
  "upstream_interval": 300,
  "min_free_gb": 20,
  "runs_max_gb": 100,
  "public_url": "",
  "webhook_secret": "",
  "webhook_urls": [],
  "webhook_timeout": 10,
  "webhook_max_attempts": 6,
  "webhook_retry_base_seconds": 2,
  "webhook_max_delay_seconds": 300,
  "webhook_retention_seconds": 604800,
  "estimate_window": 20,
  "estimate_min_samples": 3,
  "max_wait_seconds": 60,
  "max_waiters": 16,
  "max_event_streams": 8,
  "event_heartbeat_seconds": 15,
  "event_retention": 10000,
  "idempotency_window_seconds": 86400,
  "janitor_interval": 30
}
